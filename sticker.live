<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Stickers Nova</title>
<style>
  body{
    background:#111;
    color:#fff;
    font-family:system-ui,sans-serif;
    padding:20px;
    margin:0;
  }
  h1{text-align:center;font-size:20px;margin-bottom:20px}
  .grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(140px,1fr));
    gap:16px;
    max-width:900px;
    margin:0 auto;
  }
  .card{
    background:#1a1a24;
    border:1px solid #333;
    border-radius:16px;
    padding:14px;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:8px;
  }
  .card svg{
    width:100px;
    height:100px;
  }
  .name{
    font-size:13px;
    color:#ccc;
  }
  .rarity-comun{color:#9ab0c0}
  .rarity-raro{color:#8b7bff}
  .rarity-epico{color:#ffb800}
  .rarity-legendario{
    background:linear-gradient(90deg,#ff5c8a,#8b7bff,#35d0ff);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    font-weight:800;
  }
</style>
</head>
<body>
<h1>Stickers de Nova</h1>
<div class="grid">

  <!-- 1. APLAUSO -->
  <div class="card">
    <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="manoGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#ffd9b8"/>
          <stop offset="100%" stop-color="#e8a87c"/>
        </linearGradient>
      </defs>
      <circle cx="50" cy="50" r="30" fill="none" stroke="#ffd700" stroke-width="2" opacity=".6">
        <animate attributeName="r" values="20;45" dur="1s" repeatCount="indefinite"/>
        <animate attributeName="opacity" values=".8;0" dur="1s" repeatCount="indefinite"/>
      </circle>
      <g transform="rotate(-20 35 55)">
        <ellipse cx="35" cy="55" rx="12" ry="18" fill="url(#manoGrad)" stroke="#b8764a" stroke-width="1.5"/>
        <rect x="30" y="42" width="3" height="12" rx="1.5" fill="#e8a87c"/>
        <rect x="34" y="40" width="3" height="14" rx="1.5" fill="#e8a87c"/>
        <rect x="38" y="42" width="3" height="12" rx="1.5" fill="#e8a87c"/>
      </g>
      <g transform="rotate(20 65 55)">
        <ellipse cx="65" cy="55" rx="12" ry="18" fill="url(#manoGrad)" stroke="#b8764a" stroke-width="1.5"/>
        <rect x="59" y="42" width="3" height="12" rx="1.5" fill="#e8a87c"/>
        <rect x="63" y="40" width="3" height="14" rx="1.5" fill="#e8a87c"/>
        <rect x="67" y="42" width="3" height="12" rx="1.5" fill="#e8a87c"/>
      </g>
    </svg>
    <div class="name rarity-comun">Aplauso</div>
    <div class="name" style="font-size:11px;opacity:.7">0 monedas</div>
  </div>

  <!-- 2. CORAZÓN -->
  <div class="card">
    <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <radialGradient id="heartGrad" cx="35%" cy="30%" r="70%">
          <stop offset="0%" stop-color="#ff8aa0"/>
          <stop offset="60%" stop-color="#ff3b5c"/>
          <stop offset="100%" stop-color="#a8123d"/>
        </radialGradient>
      </defs>
      <path d="M50 85 C 15 55, 15 25, 35 25 C 45 25, 50 35, 50 40 C 50 35, 55 25, 65 25 C 85 25, 85 55, 50 85 Z" fill="url(#heartGrad)" stroke="#7a0025" stroke-width="1.5"/>
      <ellipse cx="38" cy="38" rx="6" ry="4" fill="#fff" opacity=".7" transform="rotate(-30 38 38)"/>
    </svg>
    <div class="name rarity-comun">Corazón</div>
    <div class="name" style="font-size:11px;opacity:.7">5 monedas</div>
  </div>

  <!-- 3. ROSA -->
  <div class="card">
    <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <radialGradient id="rosaGrad" cx="50%" cy="40%" r="60%">
          <stop offset="0%" stop-color="#ff5c8a"/>
          <stop offset="70%" stop-color="#c40043"/>
          <stop offset="100%" stop-color="#6e0022"/>
        </radialGradient>
      </defs>
      <rect x="48" y="55" width="4" height="35" fill="#3aa856" rx="2"/>
      <path d="M50 70 Q 30 65 28 78 Q 38 80 50 70 Z" fill="#2e8a43"/>
      <circle cx="50" cy="35" r="22" fill="url(#rosaGrad)"/>
      <ellipse cx="50" cy="36" rx="9" ry="11" fill="#8a0033"/>
      <ellipse cx="50" cy="36" rx="4" ry="6" fill="#5a0020"/>
    </svg>
    <div class="name rarity-comun">Rosa</div>
    <div class="name" style="font-size:11px;opacity:.7">10 monedas</div>
  </div>

  <!-- 4. HELADO -->
  <div class="card">
    <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="conoGrad2" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#e8b46a"/>
          <stop offset="100%" stop-color="#a86e2e"/>
        </linearGradient>
        <radialGradient id="bolaGrad2" cx="40%" cy="30%" r="70%">
          <stop offset="0%" stop-color="#ffe9f2"/>
          <stop offset="60%" stop-color="#ff9ec4"/>
          <stop offset="100%" stop-color="#d86088"/>
        </radialGradient>
      </defs>
      <path d="M35 50 L50 92 L65 50 Z" fill="url(#conoGrad2)" stroke="#6e4218" stroke-width="1.5"/>
      <circle cx="50" cy="42" r="22" fill="url(#bolaGrad2)" stroke="#a8385e" stroke-width="1.5"/>
      <rect x="38" y="34" width="3" height="3" fill="#ff3b5c"/>
      <rect x="58" y="38" width="3" height="3" fill="#35d0ff"/>
      <rect x="50" y="28" width="3" height="3" fill="#ffe27a"/>
    </svg>
    <div class="name rarity-comun">Helado</div>
    <div class="name" style="font-size:11px;opacity:.7">20 monedas</div>
  </div>

  <!-- 5. PIZZA -->
  <div class="card">
    <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <path d="M50 12 L 88 82 Q 50 92 12 82 Z" fill="#ffd675" stroke="#7a4a10" stroke-width="2"/>
      <path d="M50 20 L 82 78 Q 50 86 18 78 Z" fill="#d63b1f"/>
      <path d="M50 24 L 78 76 Q 50 82 22 76 Z" fill="#ffd97a"/>
      <circle cx="42" cy="45" r="4" fill="#8a1c0f"/>
      <circle cx="58" cy="55" r="4.5" fill="#8a1c0f"/>
      <circle cx="50" cy="68" r="4" fill="#8a1c0f"/>
    </svg>
    <div class="name rarity-raro">Pizza</div>
    <div class="name" style="font-size:11px;opacity:.7">50 monedas</div>
  </div>

  <!-- 6. COCHE -->
  <div class="card">
    <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="cocheGrad2" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#ff5c3b"/>
          <stop offset="100%" stop-color="#a81e0a"/>
        </linearGradient>
      </defs>
      <path d="M5 55 L 25 55" stroke="#ffd700" stroke-width="3" stroke-linecap="round">
        <animate attributeName="opacity" values="0;1;0" dur=".6s" repeatCount="indefinite"/>
      </path>
      <path d="M20 68 Q 22 50 40 48 L 65 48 Q 82 50 84 68 Z" fill="url(#cocheGrad2)" stroke="#5a0e00" stroke-width="1.5"/>
      <path d="M38 48 Q 45 35 55 35 Q 65 35 70 48 Z" fill="#a81e0a"/>
      <path d="M42 46 Q 47 38 54 38 L 60 38 Q 64 38 66 46 Z" fill="#8ee0ff"/>
      <circle cx="32" cy="70" r="7" fill="#1a1a1a"/>
      <circle cx="72" cy="70" r="7" fill="#1a1a1a"/>
      <circle cx="32" cy="70" r="3" fill="#999"/>
      <circle cx="72" cy="70" r="3" fill="#999"/>
    </svg>
    <div class="name rarity-raro">Coche</div>
    <div class="name" style="font-size:11px;opacity:.7">100 monedas</div>
  </div>

  <!-- 7. CORONA -->
  <div class="card">
    <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="coronaGrad2" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#ffe27a"/>
          <stop offset="50%" stop-color="#ffb800"/>
          <stop offset="100%" stop-color="#b07500"/>
        </linearGradient>
      </defs>
      <path d="M20 65 L 25 40 L 35 55 L 50 30 L 65 55 L 75 40 L 80 65 Z" fill="url(#coronaGrad2)" stroke="#7a4a00" stroke-width="2"/>
      <rect x="20" y="65" width="60" height="10" rx="3" fill="#b07500" stroke="#5a3000" stroke-width="1.5"/>
      <circle cx="50" cy="30" r="4" fill="#8ee0ff" stroke="#004a75" stroke-width="1"/>
      <circle cx="25" cy="40" r="3" fill="#ff3b5c"/>
      <circle cx="75" cy="40" r="3" fill="#ff3b5c"/>
    </svg>
    <div class="name rarity-epico">Corona</div>
    <div class="name" style="font-size:11px;opacity:.7">250 monedas</div>
  </div>

  <!-- 8. COHETE -->
  <div class="card">
    <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="coheteGrad2" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#fff"/>
          <stop offset="100%" stop-color="#b0b0c0"/>
        </linearGradient>
        <linearGradient id="fuegoGrad2" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#fff6a0"/>
          <stop offset="40%" stop-color="#ff9500"/>
          <stop offset="100%" stop-color="#ff3b00"/>
        </linearGradient>
      </defs>
      <path d="M42 78 Q 50 100 58 78 Q 55 82 50 78 Q 45 82 42 78 Z" fill="url(#fuegoGrad2)">
        <animate attributeName="d" values="M42 78 Q 50 100 58 78 Q 55 82 50 78 Q 45 82 42 78 Z;M42 78 Q 50 95 58 78 Q 55 82 50 78 Q 45 82 42 78 Z;M42 78 Q 50 100 58 78 Q 55 82 50 78 Q 45 82 42 78 Z" dur=".3s" repeatCount="indefinite"/>
      </path>
      <path d="M35 70 L 25 85 L 40 75 Z" fill="#d63b1f"/>
      <path d="M65 70 L 75 85 L 60 75 Z" fill="#d63b1f"/>
      <path d="M50 10 Q 65 40 62 78 L 38 78 Q 35 40 50 10 Z" fill="url(#coheteGrad2)" stroke="#5a5a6e" stroke-width="1.5"/>
      <circle cx="50" cy="38" r="8" fill="#8ee0ff" stroke="#2b6c8f" stroke-width="2"/>
    </svg>
    <div class="name rarity-epico">Cohete</div>
    <div class="name" style="font-size:11px;opacity:.7">500 monedas</div>
  </div>

  <!-- 9. DRAGÓN -->
  <div class="card">
    <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="dragonGrad2" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#3aa856"/>
          <stop offset="50%" stop-color="#1e5c2d"/>
          <stop offset="100%" stop-color="#0a3018"/>
        </linearGradient>
      </defs>
      <path d="M78 48 Q 95 42 88 50 Q 95 55 78 52 Z" fill="#ff9500">
        <animate attributeName="d" values="M78 48 Q 95 42 88 50 Q 95 55 78 52 Z;M78 48 Q 90 40 90 50 Q 90 56 78 52 Z;M78 48 Q 95 42 88 50 Q 95 55 78 52 Z" dur=".4s" repeatCount="indefinite"/>
      </path>
      <path d="M40 45 Q 55 20 70 25 Q 65 40 60 48 Z" fill="#2e8a43" stroke="#062010" stroke-width="1.2"/>
      <path d="M25 55 Q 30 40 45 42 Q 60 40 72 48 Q 70 60 60 62 Q 45 64 30 62 Z" fill="url(#dragonGrad2)" stroke="#062010" stroke-width="1.5"/>
      <path d="M70 42 Q 82 38 85 48 Q 82 56 72 56 L 66 52 L 66 44 Z" fill="url(#dragonGrad2)" stroke="#062010" stroke-width="1.2"/>
      <circle cx="78" cy="46" r="2.5" fill="#ffd700"/>
      <circle cx="78" cy="46" r="1" fill="#000"/>
    </svg>
    <div class="name rarity-legendario">Dragón</div>
    <div class="name" style="font-size:11px;opacity:.7">1000 monedas</div>
  </div>

  <!-- 10. CASTILLO -->
  <div class="card">
    <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="castilloGrad2" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#c9c2b5"/>
          <stop offset="100%" stop-color="#7a7264"/>
        </linearGradient>
        <linearGradient id="tejadoGrad2" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#d63b1f"/>
          <stop offset="100%" stop-color="#7a1a00"/>
        </linearGradient>
      </defs>
      <rect x="15" y="45" width="18" height="42" fill="url(#castilloGrad2)" stroke="#4a443a" stroke-width="1.5"/>
      <polygon points="13,35 24,20 35,35" fill="url(#tejadoGrad2)" stroke="#4a1a00" stroke-width="1"/>
      <rect x="35" y="35" width="30" height="52" fill="url(#castilloGrad2)" stroke="#4a443a" stroke-width="1.5"/>
      <polygon points="33,25 50,8 67,25" fill="url(#tejadoGrad2)" stroke="#4a1a00" stroke-width="1"/>
      <path d="M50 2 L 60 4 L 50 6 Z" fill="#d63b1f">
        <animate attributeName="d" values="M50 2 L 60 4 L 50 6 Z;M50 2 L 58 5 L 50 6 Z;M50 2 L 60 4 L 50 6 Z" dur="1s" repeatCount="indefinite"/>
      </path>
      <path d="M42 75 L 42 60 Q 50 52 58 60 L 58 75 Z" fill="#3a2a1a"/>
      <rect x="67" y="45" width="18" height="42" fill="url(#castilloGrad2)" stroke="#4a443a" stroke-width="1.5"/>
      <polygon points="65,35 76,20 87,35" fill="url(#tejadoGrad2)" stroke="#4a1a00" stroke-width="1"/>
      <rect x="10" y="85" width="80" height="6" fill="#4a443a"/>
    </svg>
    <div class="name rarity-legendario">Castillo</div>
    <div class="name" style="font-size:11px;opacity:.7">2000 monedas</div>
  </div>

</div>
</body>
</html>
